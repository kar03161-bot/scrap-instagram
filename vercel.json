{
  "version": 2,
  "functions": {
    "src/server.js": {
      "memory": 3008,
      "maxDuration": 60
    }
  },
  "builds": [
    {
      "src": "src/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "node_modules/puppeteer-extra-plugin-stealth/evasions/**",
          "node_modules/puppeteer-extra-plugin-user-preferences/**",
          "node_modules/puppeteer-extra-plugin-user-data-dir/**",
          "node_modules/@sparticuz/chromium/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/server.js"
    }
  ]
}
